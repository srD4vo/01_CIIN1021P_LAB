  <DataSources>
    <DataSource Name="dsDataSalud">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=BDDataSaludTema06</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>ff16077c-5587-4b79-821c-172edba96a52</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsEstablecimientos">
      <Query>
        <DataSourceName>dsDataSalud</DataSourceName>
        <CommandText>SELECT CodigoEstablecimiento, CodigoEstablecimiento + ' - ' + Nombre AS Etiqueta
FROM dw.DimEstablecimiento
ORDER BY CodigoEstablecimiento;</CommandText>
      </Query>
      <Fields>
        <Field Name="CodigoEstablecimiento">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CodigoEstablecimiento</DataField>
        </Field>
        <Field Name="Etiqueta">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Etiqueta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsAtencionesEstablecimiento">
      <Query>
        <DataSourceName>dsDataSalud</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CodigoEstablecimiento">
            <Value>=Parameters!CodigoEstablecimiento.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT f.Mes, f.NombreMes, t.TipoAtencion,
       COUNT(*)               AS Atenciones,
       SUM(h.DuracionMinutos) AS Minutos
FROM dw.FactAtencion AS h
INNER JOIN dw.DimFecha           AS f ON f.FechaKey = h.FechaKey
INNER JOIN dw.DimTipoAtencion    AS t ON t.TipoAtencionKey = h.TipoAtencionKey
INNER JOIN dw.DimEstablecimiento AS e ON e.EstablecimientoKey = h.EstablecimientoKey
WHERE e.CodigoEstablecimiento = @CodigoEstablecimiento
GROUP BY f.Mes, f.NombreMes, t.TipoAtencion
ORDER BY f.Mes, t.TipoAtencion;</CommandText>
      </Query>
      <Fields>
        <Field Name="Mes">
          <rd:TypeName>System.Byte</rd:TypeName>
          <DataField>Mes</DataField>
        </Field>
        <Field Name="NombreMes">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NombreMes</DataField>
        </Field>
        <Field Name="TipoAtencion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TipoAtencion</DataField>
        </Field>
        <Field Name="Atenciones">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Atenciones</DataField>
        </Field>
        <Field Name="Minutos">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Minutos</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
